<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="grem::Allocation&lt;*&gt;">
    <DisplayString Optional="true" Condition="elementCount == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 1">[{elements[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 2">[{elements[0]}, {elements[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 3">[{elements[0]}, {elements[1]}, {elements[2]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount &gt;= 4">[... ({elementCount} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">elementCount</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <ArrayItems>
        <Size>elementCount</Size>
        <ValuePointer>elements</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::Array&lt;*,*&gt;">
    <DisplayString Optional="true" Condition="$T2 == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="$T2 == 1">[{_private_elements[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="$T2 == 2">[{_private_elements[0]}, {_private_elements[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="$T2 == 3">[{_private_elements[0]}, {_private_elements[1]}, {_private_elements[2]}]</DisplayString>
    <DisplayString Optional="true" Condition="$T2 &gt;= 4">[... ({$T2} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">$T2</Item>
      <ArrayItems>
        <Size>$T2</Size>
        <ValuePointer>_private_elements</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::ArrayList&lt;*&gt;">
    <DisplayString Optional="true" Condition="elementCount == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 1">[{elements[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 2">[{elements[0]}, {elements[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 3">[{elements[0]}, {elements[1]}, {elements[2]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount &gt;= 4">[... ({elementCount} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">(size_t)elementCount</Item>
      <Item Name="capacity()" ExcludeView="simple">(size_t)elementCapacity</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <ArrayItems>
        <Size>elementCount</Size>
        <ValuePointer>elements</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::BitArray&lt;*&gt;">
    <Intrinsic Name="get" Expression="((bits[i / INTEGER_BITS] &gt;&gt; (i % INTEGER_BITS)) &amp; 1) != 0">
      <Parameter Name="i" Type="size_t" />
    </Intrinsic>
    <DisplayString Optional="true" Condition="$T1 == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 1">[{get(0)}]</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 2">[{get(0)}, {get(1)}]</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 3">[{get(0)}, {get(1)}, {get(2)}]</DisplayString>
    <DisplayString Optional="true" Condition="$T1 &gt;= 4">[... ({$T1} items)]</DisplayString>
    <Expand>
      <IndexListItems>
        <Size>$T1</Size>
        <ValueNode>get($i)</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>

  <Type Name="grem::BitBufferBase&lt;*&gt;">
    <Intrinsic Name="get" Expression="((bits[i / INTEGER_BITS] &gt;&gt; (i % INTEGER_BITS)) &amp; 1) != 0">
      <Parameter Name="i" Type="size_t" />
    </Intrinsic>
    <DisplayString Optional="true" Condition="bitCount == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="bitCount == 1">[{get(0)}]</DisplayString>
    <DisplayString Optional="true" Condition="bitCount == 2">[{get(0)}, {get(1)}]</DisplayString>
    <DisplayString Optional="true" Condition="bitCount == 3">[{get(0)}, {get(1)}, {get(2)}]</DisplayString>
    <DisplayString Optional="true" Condition="bitCount &gt;= 4">[... ({bitCount} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">bitCount</Item>
      <Item Name="capacity()" ExcludeView="simple">bitCapacity</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <IndexListItems>
        <Size>bitCount</Size>
        <ValueNode>get($i)</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>

  <Type Name="grem::Buffer&lt;*&gt;">
    <DisplayString Optional="true" Condition="elementCount == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 1">[{elements[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 2">[{elements[0]}, {elements[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 3">[{elements[0]}, {elements[1]}, {elements[2]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount &gt;= 4">[... ({elementCount} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">elementCount</Item>
      <Item Name="capacity()" ExcludeView="simple">elementCapacity</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <ArrayItems>
        <Size>elementCount</Size>
        <ValuePointer>elements</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::ConstantString&lt;*&gt;">
    <DisplayString>{characters,na}</DisplayString>
    <StringView>characters,na</StringView>
  </Type>

  <Type Name="grem::CRC32">
    <DisplayString>{value,X}</DisplayString>
    <Expand>
      <Item Name="uint32_t()">value</Item>
    </Expand>
  </Type>

  <Type Name="grem::CStringViewBase&lt;*&gt;">
    <DisplayString>{string,na}</DisplayString>
    <StringView>string,na</StringView>
  </Type>

  <Type Name="grem::DoubleEndedQueue&lt;*&gt;">
    <Intrinsic Name="size" Expression="(size_t)(endIndex - beginIndex)" />
    <Intrinsic Name="capacity" Expression="(mask == 0) ? (size_t)0 : (size_t)(mask + 1)" />
    <Intrinsic Name="at" Expression="&amp;ringBuffer[(beginIndex + i) &amp; mask]">
      <Parameter Name="i" Type="size_t" />
    </Intrinsic>
    <DisplayString Optional="true" Condition="size() == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 1">[{*at(0)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 2">[{*at(0)}, {*at(1)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 3">[{*at(0)}, {*at(1)}, {*at(2)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() &gt;= 4">[... ({size()} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">size()</Item>
      <Item Name="capacity()" ExcludeView="simple">capacity()</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <IndexListItems>
        <Size>size()</Size>
        <ValueNode>*at($i)</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>

  <Type Name="grem::HashMap&lt;*&gt;">
    <DisplayString Optional="true" Condition="elementCount == 0">{{}}</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 1">{{... (1 item)}}</DisplayString>
    <DisplayString Optional="true" Condition="elementCount &gt;= 2">{{... ({elementCount} items)}}</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">elementCount</Item>
      <Item Name="capacity()" ExcludeView="simple">elementCapacity</Item>
      <Item Name="hash_function()" ExcludeView="simple">hash</Item>
      <Item Name="key_eq()" ExcludeView="simple">equal</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <CustomListItems>
        <Variable Name="i" InitialValue="0" />
        <Size>elementCapacity</Size>
        <Loop>
          <Item Name="[{keys[i]}]" Condition="(activeBits[i / 64] &amp; (1 &lt;&lt; (i % 64))) != 0">values[i]</Item>
          <Exec>++i</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <Type Name="grem::HashSet&lt;*&gt;">
    <DisplayString Optional="true" Condition="elementCount == 0">{{}}</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 1">{{... (1 item)}}</DisplayString>
    <DisplayString Optional="true" Condition="elementCount != 0">{{... ({elementCount} items)}}</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">elementCount</Item>
      <Item Name="capacity()" ExcludeView="simple">elementCapacity</Item>
      <Item Name="hash_function()" ExcludeView="simple">hash</Item>
      <Item Name="key_eq()" ExcludeView="simple">equal</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <CustomListItems>
        <Variable Name="i" InitialValue="0" />
        <Size>elementCapacity</Size>
        <Loop>
          <Item>keys[i]</Item>
          <Exec>++i</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <Type Name="grem::InplaceArrayList&lt;*,*&gt;">
    <DisplayString Optional="true" Condition="elementCount == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 1">[{(($T1*)buffer)[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 2">[{(($T1*)buffer)[0]}, {(($T1*)buffer)[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 3">[{(($T1*)buffer)[0]}, {(($T1*)buffer)[1]}, {(($T1*)buffer)[2]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount &gt;= 4">[... ({elementCount} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">(size_t)elementCount</Item>
      <Item Name="capacity()" ExcludeView="simple">$T2</Item>
      <ArrayItems>
        <Size>elementCount</Size>
        <ValuePointer>($T1*)buffer</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::InplaceBuffer&lt;*,*&gt;">
    <DisplayString Optional="true" Condition="elementCount == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 1">[{(($T1*)buffer)[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 2">[{(($T1*)buffer)[0]}, {(($T1*)buffer)[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 3">[{(($T1*)buffer)[0]}, {(($T1*)buffer)[1]}, {(($T1*)buffer)[2]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount &gt;= 4">[... ({elementCount} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">(size_t)elementCount</Item>
      <Item Name="capacity()" ExcludeView="simple">$T2</Item>
      <ArrayItems>
        <Size>elementCount</Size>
        <ValuePointer>($T1*)buffer</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::InplaceDoubleEndedQueue&lt;*,*&gt;">
    <Intrinsic Name="size" Expression="(size_t)(endIndex - beginIndex)" />
    <Intrinsic Name="at" Expression="&amp;ringBuffer[(beginIndex + i) &amp; ($T2 - 1)]">
      <Parameter Name="i" Type="size_t" />
    </Intrinsic>
    <DisplayString Optional="true" Condition="size() == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 1">[{*at(0)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 2">[{*at(0)}, {*at(1)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 3">[{*at(0)}, {*at(1)}, {*at(2)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() &gt;= 4">[... ({size()} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">size()</Item>
      <Item Name="capacity()" ExcludeView="simple">$T2</Item>
      <IndexListItems>
        <Size>size()</Size>
        <ValueNode>*at($i)</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>

  <Type Name="grem::InplaceRingBuffer&lt;*,*&gt;">
    <Intrinsic Name="size" Expression="(size_t)(endIndex - beginIndex)" />
    <Intrinsic Name="at" Expression="&amp;ringBuffer[(beginIndex + i) &amp; ($T2 - 1)]">
      <Parameter Name="i" Type="size_t" />
    </Intrinsic>
    <DisplayString Optional="true" Condition="size() == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 1">[{*at(0)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 2">[{*at(0)}, {*at(1)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 3">[{*at(0)}, {*at(1)}, {*at(2)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() &gt;= 4">[... ({size()} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">size()</Item>
      <Item Name="capacity()" ExcludeView="simple">$T2</Item>
      <IndexListItems>
        <Size>size()</Size>
        <ValueNode>*at($i)</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>

  <Type Name="grem::vec&lt;*,*&gt;">
    <DisplayString Optional="true" Condition="$T1 == 1">({x})</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 2">({x}, {y})</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 3">({x}, {y}, {z})</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 4">({x}, {y}, {z}, {w})</DisplayString>
    <Expand>
      <Item Name="x" Optional="true" Condition="$T1 &gt;= 1">x</Item>
      <Item Name="y" Optional="true" Condition="$T1 &gt;= 2">y</Item>
      <Item Name="z" Optional="true" Condition="$T1 &gt;= 3">z</Item>
      <Item Name="w" Optional="true" Condition="$T1 &gt;= 4">w</Item>
    </Expand>
  </Type>

  <Type Name="grem::mat&lt;*,*,*&gt;">
    <DisplayString Optional="true" Condition="$T1 == 1">[{_private_value[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 2">[{_private_value[0]}, {_private_value[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 3">[{_private_value[0]}, {_private_value[1]}, {_private_value[2]}]</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 4">[{_private_value[0]}, {_private_value[1]}, {_private_value[2]}, {_private_value[3]}]</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>$T1</Size>
        <ValuePointer>_private_value</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::qua&lt;*&gt;">
    <DisplayString>{x}i + {y}j + {z}k + {w}</DisplayString>
    <Expand>
      <Item Name="x">x</Item>
      <Item Name="y">y</Item>
      <Item Name="z">z</Item>
      <Item Name="w">w</Item>
    </Expand>
  </Type>

  <Type Name="grem::Optional&lt;*&gt;">
    <DisplayString Condition="variant.activeTypeIndex == 0">nullopt</DisplayString>
    <DisplayString Condition="variant.activeTypeIndex == 1">{variant.storage.tail.head}</DisplayString>
    <Expand>
      <Item Name="has_value()">variant.activeTypeIndex == 1</Item>
      <Item Condition="variant.activeTypeIndex == 1" Name="value()">variant.storage.tail.head</Item>
    </Expand>
  </Type>

  <Type Name="grem::OrderedMap&lt;*&gt;">
    <AlternativeType Name="grem::OrderedMultimap&lt;*&gt;" />
    <DisplayString Optional="true" Condition="elementCount == 0">{{}}</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 1">{{... (1 item)}}</DisplayString>
    <DisplayString Optional="true" Condition="elementCount &gt;= 2">{{... ({elementCount} items)}}</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">elementCount</Item>
      <Item Name="key_comp()" ExcludeView="simple">compare.comp</Item>
      <Item Name="value_comp()" ExcludeView="simple">compare</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <CustomListItems>
        <Variable Name="i" InitialValue="0" />
        <Size>elementCount</Size>
        <Loop>
          <Item Name="[{elements[i].first}]">elements[i].second</Item>
          <Exec>++i</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <Type Name="grem::Pair&lt;*&gt;">
    <DisplayString>({first}, {second})</DisplayString>
    <Expand>
      <Item Name="first">first</Item>
      <Item Name="second">second</Item>
    </Expand>
  </Type>

  <Type Name="grem::RegistryElementIDBase&lt;*&gt;">
    <DisplayString Condition="value == 0xFFFFFFFF">INVALID</DisplayString>
    <DisplayString Condition="value != 0xFFFFFFFF">{{index = {value &amp; 0xFFFF}, generation = {(value &gt;&gt; 16) &amp; 0x3FFF}, flags = {(value &gt;&gt; 30) &amp; 0x3,b}}}</DisplayString>
    <Expand>
      <Item Name="index">(unsigned short)(value &amp; 0xFFFF)</Item>
      <Item Name="generation">(unsigned short)((value &gt;&gt; 16) &amp; 0x3FFF)</Item>
      <Item Name="flags">(unsigned char)((value &gt;&gt; 30) &amp; 0x3),b</Item>
    </Expand>
  </Type>

  <Type Name="grem::RingBuffer&lt;*&gt;">
    <Intrinsic Name="size" Expression="(endIndex - beginIndex)" />
    <Intrinsic Name="capacity" Expression="(mask == 0) ? (size_t)0 : mask + 1" />
    <Intrinsic Name="at" Expression="&amp;ringBuffer[(beginIndex + i) &amp; mask]">
      <Parameter Name="i" Type="size_t" />
    </Intrinsic>
    <DisplayString Optional="true" Condition="size() == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 1">[{*at(0)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 2">[{*at(0)}, {*at(1)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 3">[{*at(0)}, {*at(1)}, {*at(2)}]</DisplayString>
    <DisplayString Optional="true" Condition="size() &gt;= 4">[... ({size()} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">size()</Item>
      <Item Name="capacity()" ExcludeView="simple">capacity()</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <IndexListItems>
        <Size>size()</Size>
        <ValueNode>*at($i)</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>

  <Type Name="grem::SharedPointer&lt;void&gt;">
    <Intrinsic Name="use_count" Expression="controlBlock-&gt;strongReferenceCount" />
    <SmartPointer Usage="Minimal">object</SmartPointer>
    <DisplayString Condition="object == 0">nullptr</DisplayString>
    <DisplayString Condition="object != 0 &amp;&amp; controlBlock == 0">empty</DisplayString>
    <DisplayString Condition="object != 0 &amp;&amp; controlBlock != 0">void</DisplayString>
    <Expand>
      <Item Condition="controlBlock != 0" Name="(total reference count)">controlBlock-&gt;totalReferenceCount</Item>
      <Item Condition="controlBlock != 0" Name="use_count()">use_count()</Item>
      <Item Condition="controlBlock != 0" Name="get()">object</Item>
    </Expand>
  </Type>

  <Type Name="grem::SharedPointer&lt;*&gt;">
    <Intrinsic Name="use_count" Expression="controlBlock-&gt;strongReferenceCount" />
    <SmartPointer Usage="Minimal">object</SmartPointer>
    <DisplayString Condition="object == 0">nullptr</DisplayString>
    <DisplayString Condition="object != 0 &amp;&amp; controlBlock == 0">empty</DisplayString>
    <DisplayString Condition="object != 0 &amp;&amp; controlBlock != 0">{*object}</DisplayString>
    <Expand>
      <Item Condition="controlBlock != 0" Name="(total reference count)">controlBlock-&gt;totalReferenceCount</Item>
      <Item Condition="controlBlock != 0" Name="use_count()">use_count()</Item>
      <Item Condition="controlBlock != 0" Name="get()">object</Item>
    </Expand>
  </Type>

  <Type Name="grem::WeakPointer&lt;void&gt;">
    <Intrinsic Name="use_count" Expression="controlBlock-&gt;strongReferenceCount" />
    <DisplayString Condition="object == 0">nullptr</DisplayString>
    <DisplayString Condition="object != 0 &amp;&amp; controlBlock == 0">empty</DisplayString>
    <DisplayString Condition="object != 0 &amp;&amp; controlBlock != 0 &amp;&amp; use_count() == 0">expired</DisplayString>
    <DisplayString Condition="object != 0 &amp;&amp; controlBlock != 0 &amp;&amp; use_count() != 0">void</DisplayString>
    <Expand>
      <Item Condition="controlBlock != 0" Name="(total reference count)">controlBlock-&gt;totalReferenceCount</Item>
      <Item Condition="controlBlock != 0" Name="use_count()">use_count()</Item>
      <Item Condition="controlBlock != 0 &amp;&amp; (object == 0 || use_count() != 0)" Name="get()">object</Item>
    </Expand>
  </Type>

  <Type Name="grem::WeakPointer&lt;*&gt;">
    <Intrinsic Name="use_count" Expression="controlBlock-&gt;strongReferenceCount" />
    <DisplayString Condition="object == 0">nullptr</DisplayString>
    <DisplayString Condition="object != 0 &amp;&amp; controlBlock == 0">empty</DisplayString>
    <DisplayString Condition="object != 0 &amp;&amp; controlBlock != 0 &amp;&amp; use_count() == 0">expired</DisplayString>
    <DisplayString Condition="object != 0 &amp;&amp; controlBlock != 0 &amp;&amp; use_count() != 0">{*object}</DisplayString>
    <Expand>
      <Item Condition="controlBlock != 0" Name="(total reference count)">controlBlock-&gt;totalReferenceCount</Item>
      <Item Condition="controlBlock != 0" Name="use_count()">use_count()</Item>
      <Item Condition="controlBlock != 0 &amp;&amp; (object == 0 || use_count() != 0)" Name="get()">object</Item>
    </Expand>
  </Type>

  <Type Name="grem::SmallArrayList&lt;*&gt;">
    <DisplayString Optional="true" Condition="elementCount == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 1">[{elements[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 2">[{elements[0]}, {elements[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 3">[{elements[0]}, {elements[1]}, {elements[2]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount &gt;= 4">[... ({elementCount} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">(size_t)elementCount</Item>
      <Item Name="capacity()" ExcludeView="simple">elementCapacity</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <ArrayItems>
        <Size>elementCount</Size>
        <ValuePointer>elements</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::SmallBuffer&lt;*&gt;">
    <DisplayString Optional="true" Condition="elementCount == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 1">[{elements[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 2">[{elements[0]}, {elements[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount == 3">[{elements[0]}, {elements[1]}, {elements[2]}]</DisplayString>
    <DisplayString Optional="true" Condition="elementCount &gt;= 4">[... ({elementCount} items)]</DisplayString>
    <Expand>
      <Item Name="size()" ExcludeView="simple">(size_t)elementCount</Item>
      <Item Name="capacity()" ExcludeView="simple">elementCapacity</Item>
      <Item Name="get_allocator()" ExcludeView="simple">allocator</Item>
      <ArrayItems>
        <Size>elementCount</Size>
        <ValuePointer>elements</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::Span&lt;*,*&gt;">
    <Intrinsic Name="data" Expression="((Base*)this)-&gt;elements" />
	<Intrinsic Name="size" Optional="true" Expression="(size_t)$T2" />
    <Intrinsic Name="size" Optional="true" Expression="((Base*)this)-&gt;elementCount" />
    <DisplayString Optional="true" Condition="size() == 0">[]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 1">[{data()[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 2">[{data()[0]}, {data()[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="size() == 3">[{data()[0]}, {data()[1]}, {data()[2]}]</DisplayString>
    <DisplayString Optional="true" Condition="size() &gt;= 4">[... ({size()} items)]</DisplayString>
    <Expand>
      <Item Name="data()" ExcludeView="simple">data()</Item>
      <Item Name="size()" ExcludeView="simple">size()</Item>
      <ArrayItems>
        <Size>size()</Size>
        <ValuePointer>data()</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::StridedSpan&lt;*,*,*&gt;">
    <Intrinsic Name="base" Expression="((Base*)this)-&gt;elements" />
    <Intrinsic Optional="true" Name="size" Expression="(size_t)$T2" />
    <Intrinsic Optional="true" Name="size" Expression="elementCount" />
