    <Intrinsic Name="port6" Expression="addr.sin6_port" />
    <DisplayString Condition="port6() == 0">{addr6()[0],xb}:{addr6()[1],xb}:{addr6()[2],xb}:{addr6()[3],xb}:{addr6()[4],xb}:{addr6()[5],xb}:{addr6()[6],xb}:{addr6()[7],xb}</DisplayString>
    <DisplayString Condition="port6() != 0">[{addr6()[0],xb}:{addr6()[1],xb}:{addr6()[2],xb}:{addr6()[3],xb}:{addr6()[4],xb}:{addr6()[5],xb}:{addr6()[6],xb}:{addr6()[7],xb}]:{((port6() &amp; 0x00FF) &lt;&lt; 8) | ((port6() &amp; 0xFF00) &gt;&gt; 8),d}</DisplayString>
  </Type>

  <Type Name="grem::networking::Endpoint">
    <Intrinsic Name="family" Expression="*(short*)&amp;storage" />
    <Intrinsic Name="addr4" Expression="(((sockaddr_in*)&amp;storage)-&gt;sin_addr.S_un.S_addr)" />
    <Intrinsic Name="port4" Expression="(((sockaddr_in*)&amp;storage)-&gt;sin_port)" />
    <Intrinsic Name="addr6" Expression="(unsigned short*)(((sockaddr_in*)&amp;storage)-&gt;sin6_addr)" />
    <Intrinsic Name="port6" Expression="(((sockaddr_in*)&amp;storage)-&gt;sin6_port)" />
    <DisplayString Condition="family() == 2 &amp;&amp; port4() == 0">{(addr4() &gt;&gt; 0) &amp; 0xFF,d}.{(addr4() &gt;&gt; 8) &amp; 0xFF,d}.{(addr4() &gt;&gt; 16) &amp; 0xFF,d}.{(addr4() &gt;&gt; 24) &amp; 0xFF,d}</DisplayString>
    <DisplayString Condition="family() == 2 &amp;&amp; port4() != 0">{(addr4() &gt;&gt; 0) &amp; 0xFF,d}.{(addr4() &gt;&gt; 8) &amp; 0xFF,d}.{(addr4() &gt;&gt; 16) &amp; 0xFF,d}.{(addr4() &gt;&gt; 24) &amp; 0xFF,d}:{((port4() &amp; 0x00FF) &lt;&lt; 8) | ((port4() &amp; 0xFF00) &gt;&gt; 8),d}</DisplayString>
    <DisplayString Condition="family() == 23 &amp;&amp; port6() == 0">{addr6()[0],xb}:{addr6()[1],xb}:{addr6()[2],xb}:{addr6()[3],xb}:{addr6()[4],xb}:{addr6()[5],xb}:{addr6()[6],xb}:{addr6()[7],xb}</DisplayString>
    <DisplayString Condition="family() == 23 &amp;&amp; port6() != 0">[{addr6()[0],xb}:{addr6()[1],xb}:{addr6()[2],xb}:{addr6()[3],xb}:{addr6()[4],xb}:{addr6()[5],xb}:{addr6()[6],xb}:{addr6()[7],xb}]:{((port6() &amp; 0x00FF) &lt;&lt; 8) | ((port6() &amp; 0xFF00) &gt;&gt; 8),d}</DisplayString>
  </Type>

  <Type Name="grem::physics::Zero">
    <DisplayString>0</DisplayString>
  </Type>

  <Type Name="grem::physics::Quantity&lt;*,*&gt;">
    <AlternativeType Name="grem::physics::Direction&lt;*&gt;" />
    <DisplayString Optional="true" Condition="$T1 == 1">({((float*)_private_value)[0]})</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 2">({((float*)_private_value)[0]}, {((float*)_private_value)[1]})</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 3">({((float*)_private_value)[0]}, {((float*)_private_value)[1]}, {((float*)_private_value)[2]})</DisplayString>
    <Expand>
      <Item Name="x" Optional="true" Condition="$T1 &gt;= 1">((float*)_private_value)[0]</Item>
      <Item Name="y" Optional="true" Condition="$T1 &gt;= 2">((float*)_private_value)[1]</Item>
      <Item Name="z" Optional="true" Condition="$T1 &gt;= 3">((float*)_private_value)[2]</Item>
    </Expand>
  </Type>

  <Type Name="grem::physics::TensorQuantity&lt;*,*&gt;">
    <AlternativeType Name="grem::physics::OrthonormalBasis&lt;*&gt;" />
    <DisplayString Optional="true" Condition="$T1 == 1">[{_private_value[0]}]</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 2">[{_private_value[0]}, {_private_value[1]}]</DisplayString>
    <DisplayString Optional="true" Condition="$T1 == 3">[{_private_value[0]}, {_private_value[1]}, {_private_value[2]}]</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>$T1</Size>
        <ValuePointer>_private_value</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="grem::physics::Orientation&lt;*&gt;">
    <DisplayString>{_private_value}</DisplayString>
    <Expand>
      <Item Name="x" Optional="true" Condition="$T1 == 3">_private_value.x</Item>
      <Item Name="y" Optional="true" Condition="$T1 == 3">_private_value.y</Item>
      <Item Name="z" Optional="true" Condition="$T1 == 3">_private_value.z</Item>
      <Item Name="w" Optional="true" Condition="$T1 == 3">_private_value.w</Item>
    </Expand>
  </Type>
</AutoVisualizer>
